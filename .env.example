# Copy to .env.local — never commit secrets
# false = live Nightshift AI extract; true = keyword heuristic only
SAMPLE_MODE=false

# Nightshift (local Runtime Console) — Nemotron via meterless lanes
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_EXTRACT_MODEL=meterless/auto
AI_PREFER=nightshift
# true only if Nemotron empty_response blocks the demo; keep false for recording if Nightshift is healthy
ALLOW_XAI_FALLBACK=false

# xAI backup LLM (optional)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning

# Zetaris local REST
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# Bright Data Web Unlocker (scheme portal live fetch)
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
